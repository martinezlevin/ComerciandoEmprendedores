# Google Cloud OAuth 2.0 Web client. Never expose GOOGLE_CLIENT_SECRET in browser code.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Long, random secret used to sign the HttpOnly application sessions (32+ chars).
SESSION_SECRET=replace-with-a-long-random-secret

# Public base URL, without a trailing slash. Use the Vercel deployment URL in production.
APP_BASE_URL=http://localhost:3000

# Only these Google accounts may create a seller session. The owner is Administrator;
# comma-separated collaborators receive a Colaborador session.
VENDOR_OWNER_EMAIL=owner@example.com
VENDOR_COLLABORATOR_EMAILS=collaborator@example.com

# Local development only. Never enable this in a production deployment.
DEV_AUTH_ENABLED=false
DEV_SUPERUSER_EMAIL=dev-admin@comerciando.local
DEV_SUPERUSER_PASSWORD=replace-this-development-password
